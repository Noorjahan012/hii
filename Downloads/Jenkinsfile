pipeline {

    agent any

    stages {

        stage('Checkout') {
            steps {
                echo 'Checking out source code...'
                checkout scm
            }
        }

        stage('Build') {
            steps {
                echo 'Building Event Registration Application...'
                bat 'dir'
            }
        }

        stage('Test') {
            steps {
                echo 'Testing application...'
                echo 'Application test completed successfully.'
            }
        }

        stage('Archive') {
            steps {
                echo 'Archiving project files...'

                archiveArtifacts artifacts: '**/*.html, **/*.css, **/*.js',
                                 fingerprint: true
            }
        }
    }

    post {

        success {
            echo 'Build completed successfully.'
        }

        failure {
            echo 'Build failed. Check console output.'
        }

    }
}